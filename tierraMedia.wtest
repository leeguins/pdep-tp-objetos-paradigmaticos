describe "Arsenal - Espada" {
    test "Enano con Espada con multiplicador de 15 - da 300" {
        const unEnano = new Enano(vida = 10, factorPoder = 3, arsenal = [])
        const unaEspada = new Espada(multiplicador = 15)
        assert.equals(300, unaEspada.poder(unEnano))
    }

    test "Elfo con Espada con multiplicador de 10 - da 250" {
        const unElfo = new Elfo(vida = 10, destrezaPropia = 0, arsenal = [])
        const unaEspada = new Espada(multiplicador = 10)
        assert.equals(250, unaEspada.poder(unElfo))
    }

    test "Humano con Espada con multiplicador de 10 - da 150" {
        const unHumano = new Humano(vida = 10, limitadorPoder = 2, arsenal = [])
        const unaEspada = new Espada(multiplicador = 10)
        assert.equals(150, unaEspada.poder(unHumano))
    }

    test "Guerrero de otra naturaleza con Espada con multiplicador de 10 con 2 armas - da 200" {
        const espada15 = new Espada(multiplicador = 15)
        const guerreroConDosArmas = new Hobbit(vida = 10, arsenal = [espada15, espada15], objetos = [])
        const unaEspada = new Espada(multiplicador = 10)
        assert.equals(200, unaEspada.poder(guerreroConDosArmas))
    }
}

describe "Arsenal - Daga" {
    test "Una daga da la mitad del poder que una espada " {
        const unEnano = new Enano(vida = 10, factorPoder = 3, arsenal = [])
        const unaEspada = new Espada(multiplicador = 15)
        const unaDaga = new Daga(multiplicador = 15)
        assert.equals(unaEspada.poder(unEnano) / 2, unaDaga.poder(unEnano))
    }
}

