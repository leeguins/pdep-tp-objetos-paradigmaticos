import example.*

/* -------------------- Objetos de Prueba ---------------------- */
object personaPrueba
{
    var property vidaGuerrero = 200
}

object personaPrueba2
{
    var property vidaGuerrero = 5
}

object espadaPrueba
{
    var magia = magiaEnana

    method magia(nuevaMagia) {
        magia = nuevaMagia
    }
    
    method poder(unGuerrero) {
        return 10 * magia.valorMagico(unGuerrero)
    }
}

object baculoPrueba {
    var poderBase  = 100 

    method tienePocaVida(guerrero) {
        return guerrero.vidaGuerrero() < 10
    }

    method poderPotenciado(unGuerrero) {
        if(self.tienePocaVida(unGuerrero))
            return poderBase*2
        else 
            return poderBase
    }

    method poderBase(nuevoPoder) {
        poderBase = nuevoPoder
    }

    method poder(unGuerrero) {
        return 400.min(self.poderPotenciado(unGuerrero))
    }
}

object flechaBroncePrueba
{
    var fechaLustrado = new Date(day = 1, month = 1, year = 2026)
    var fechaUso = new Date(day = 5, month = 9, year = 2026)

    method fechaLustrado(nuevaFecha) {
        fechaLustrado = nuevaFecha
    }

    method fechaUso(nuevaFecha) {
        fechaUso = nuevaFecha
    }

    method poderLustrado() {
        const diasPasados = fechaUso - fechaLustrado
        return 100 - diasPasados
    }

    method poderFlecha()
    {
        return 0.max(self.poderLustrado())
    }
}


object flechaHierroPrueba
{
    const poderActual = 70
    var oxidada = false

    method poderFlecha()
    {
        if(oxidada)
        {
            return poderActual / 2
        }
        
        return poderActual
    }
}

/* ----------------------------------------------------- */

/* ----- Test Armas Peligrosas ----- */

describe "Baculo" {
    test "El poder de un báculo, para un guerrero con mucha vida, debe ser 250" {
        assert.equals(baculo.poder(personaPrueba), 250)
    }
    test "El poder de un báculo, para un guerrero con poca vida, tiene top 200" {
        assert.equals(baculo.poder(personaPrueba2), 400)
    }
    test "El poder de un báculo con poder base 100, para un guerrero de poca vida, debe ser 200" {
        assert.equals(baculoPrueba.poder(personaPrueba2), 200)
    }
}

describe "Espada Elfica" {
    test "El poder de un espada con magia elfica, para cualquier guerrero, debe ser 250" {
        assert.equals(espada.poder(personaPrueba), 250)
    }
}

describe "Espada Enana" {
    test "El poder de un espada con magia enana, para un guerrero con 100 de vida, debe ser 500" {
        assert.equals(espadaPrueba.poder(gandalf), 500)
    }
}

describe "Flecha de bronce" {
    test "El poder de una flecha de bronce lustrada el 01/01/2026 y usada el 05/01/2026, debe ser 96" {
        assert.equals(flechaBronce.poderFlecha(), 96)
    }
    test "El poder de una flecha de bronce lustrada el 01/01/2026 y usada el 05/09/2026, debe ser 0" {
        assert.equals(flechaBroncePrueba.poderFlecha(), 0)
    }
}

describe "Flecha de aluminio" {
    test "El poder de una flecha de aluminio, debe ser 50" {
        assert.equals(flechaAluminio.poderFlecha(), 50)
    }
}

describe "Flecha de hierro" {
    test "El poder de una flecha de hierro sin oxidar, debe ser 70" {
        assert.equals(flechaHierroPrueba.poderFlecha(), 70)
    }
    test "El poder de una flecha de hierro oxidada, debe ser 35" {
        assert.equals(flechaHierro.poderFlecha(), 35)
    }
}