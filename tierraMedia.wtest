describe "Guerreros - Maiar" {
    test "Poder de Gandalf como Maiar (vida 100, factor básico, espada mult. 10, báculo 400) es 2700" {
        // vida * poderBasico + 2 * poderArsenal = 100*15 + 2*600 = 2700
        const gandalfMaiar = new Maiar(vida = 100, arsenal = [new Espada(multiplicador = 10), new Baculo(poderBase = 400)])
        assert.equals(2700, gandalfMaiar.poder())
    }

    test "Poder de Gandalf como Maiar bajo amenaza (mismos datos, factor 300) es 31200" {
        // vida * poderBajoAmenaza + 2 * poderArsenal = 100*300 + 2*600 = 31200
        const gandalfMaiar = new Maiar(vida = 100, bajoAmenaza = true, arsenal = [new Espada(multiplicador = 10), new Baculo(poderBase = 400)])
        assert.equals(31200, gandalfMaiar.poder())
    }
}

